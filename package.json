{
  "name": "aristotel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.json",
    "bench:journal": "node bench/journal.ts",
    "build:ui": "node packages/ui/build.ts",
    "bench:dictionary": "node bench/dictionary.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
