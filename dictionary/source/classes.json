{
  "templates": [
    {
      "class": "companion",
      "blocks": [
        {
          "block": "header",
          "fields": [
            {
              "label": "Класс изделия, подтип",
              "required": true,
              "defaultSource": "manual",
              "target": {
                "programField": "itemClass,itemSubtype"
              }
            },
            {
              "label": "Аппаратная платформа (плата, SoC, модель)",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "hw_element",
                "indicatorTypes": [
                  "hw_kind",
                  "hw_model",
                  "manufacturer"
                ],
                "link": "has_element"
              }
            },
            {
              "label": "Серийные номера, MAC, FCC ID, маркировки",
              "required": false,
              "defaultSource": "auto",
              "target": {
                "objectKind": "hw_element",
                "indicatorTypes": [
                  "serial",
                  "sd_cid",
                  "mcu_uid",
                  "mac",
                  "fcc_id",
                  "marking",
                  "inventory_mark"
                ]
              }
            },
            {
              "label": "Фото платы",
              "required": false,
              "defaultSource": "manual",
              "target": {
                "material": true
              },
              "note": "н, с предупреждением"
            }
          ]
        },
        {
          "block": "media",
          "fields": [
            {
              "label": "Тип носителя",
              "required": true,
              "defaultSource": "manual",
              "target": {
                "objectKind": "hw_element",
                "indicatorTypes": [
                  "media_type"
                ]
              }
            },
            {
              "label": "Объём",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "hw_element",
                "indicatorTypes": [
                  "capacity_bytes"
                ]
              }
            },
            {
              "label": "Производитель и серийный номер",
              "required": false,
              "defaultSource": "auto",
              "target": {
                "objectKind": "hw_element",
                "indicatorTypes": [
                  "manufacturer",
                  "serial",
                  "sd_cid"
                ]
              }
            },
            {
              "label": "Разметка: таблица разделов, ФС, метки, PARTUUID, UUID",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "hw_element",
                "indicatorTypes": [
                  "partition_layout",
                  "mbr_disk_id",
                  "gpt_guid",
                  "fs_uuid",
                  "fat_serial",
                  "fs_type"
                ]
              }
            },
            {
              "label": "Способ снятия",
              "required": true,
              "defaultSource": "manual",
              "target": {
                "programField": "acquisitionMethod"
              }
            },
            {
              "label": "Средство снятия с версией, станция приёмки",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "programField": "acquisitionTool,intakeStation"
              }
            },
            {
              "label": "Статус извлечения",
              "required": true,
              "defaultSource": "manual",
              "target": {
                "programField": "extractionStatus"
              }
            }
          ]
        },
        {
          "block": "os",
          "fields": [
            {
              "label": "ОС и версия; ядро",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "platform",
                "indicatorTypes": [
                  "os_distro",
                  "os_version",
                  "kernel_version"
                ]
              }
            },
            {
              "label": "Сборка образа (pi-gen commit, build id)",
              "required": false,
              "defaultSource": "auto",
              "target": {
                "objectKind": "platform",
                "indicatorTypes": [
                  "image_build",
                  "git_commit"
                ]
              }
            },
            {
              "label": "Имя хоста; machine-id",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "platform",
                "indicatorTypes": [
                  "hostname",
                  "machine_id"
                ]
              },
              "note": "О; н"
            },
            {
              "label": "Часовой пояс (Area/City); раскладка",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "platform",
                "indicatorTypes": [
                  "timezone",
                  "keyboard"
                ]
              },
              "note": "О; н"
            },
            {
              "label": "Учётки с типом хэша пароля",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "operator",
                "indicatorTypes": [
                  "username",
                  "password_hash",
                  "password_hash_type",
                  "password"
                ],
                "link": "authored_by"
              }
            },
            {
              "label": "SSH host-ключи; authorized_keys",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "key",
                "indicatorTypes": [
                  "ssh_fingerprint",
                  "key_kind",
                  "key_algo",
                  "key_comment"
                ],
                "link": "uses_key"
              }
            },
            {
              "label": "Станция сборки (build host, last mount, volume GUID)",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "build_station",
                "indicatorTypes": [
                  "build_host",
                  "win_volume_guid",
                  "indexer_volume_guid",
                  "build_path"
                ],
                "link": "built_on"
              }
            },
            {
              "label": "Шифрование: схема, LUKS UUID, привязка OTP/RFID",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "crypto",
                "indicatorTypes": [
                  "crypto_scheme",
                  "luks_uuid",
                  "key_binding",
                  "dm_name",
                  "crypto_secret"
                ]
              }
            },
            {
              "label": "Загрузка: config.txt, cmdline, overlays, загрузчик/EEPROM, secure boot",
              "required": false,
              "defaultSource": "auto",
              "target": {
                "objectKind": "platform",
                "indicatorTypes": [
                  "boot_param",
                  "dt_overlay",
                  "bootloader",
                  "secure_boot"
                ]
              }
            },
            {
              "label": "VPN и overlay (OpenVPN, ZeroTier, WireGuard)",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "infra_node",
                "indicatorTypes": [
                  "node_kind",
                  "domain",
                  "ip",
                  "port",
                  "zerotier_network",
                  "zerotier_node",
                  "x509_fingerprint",
                  "x509_cn",
                  "wireguard_pubkey"
                ],
                "link": "controlled_via"
              }
            },
            {
              "label": "Wi-Fi профили; домены и адреса",
              "required": false,
              "defaultSource": "auto",
              "target": {
                "objectKind": "radio_channel",
                "indicatorTypes": [
                  "ssid",
                  "wifi_psk"
                ],
                "link": "links_via"
              }
            },
            {
              "label": "ПО и сервисы (systemd, контейнеры, бинарники)",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "software",
                "indicatorTypes": [
                  "software_kind",
                  "software_name",
                  "software_version"
                ],
                "link": "contains_software"
              }
            }
          ]
        },
        {
          "block": "class",
          "fields": [
            {
              "label": "Назначение и полезная нагрузка (видео, наведение, сброс, РЭБ…)",
              "required": true,
              "defaultSource": "manual",
              "target": {
                "objectKind": "@item",
                "indicatorTypes": [
                  "purpose"
                ]
              }
            },
            {
              "label": "Основной стек ПО с версиями",
              "required": true,
              "defaultSource": "auto",
              "target": {
                "objectKind": "software"
              }
            },
            {
              "label": "Камера и видеопоток (интерфейс, кодек, адрес потока)",
              "required": false,
              "defaultSource": "auto",
              "target": {
                "objectKind": "radio_channel",
                "indicatorTypes": [
                  "video_url",
                  "video_codec"
                ]
              }
            },
            {
              "label": "Связь с полётным контроллером (MAVLink-роутер, UART, CAN)",
              "required": false,
              "defaultSource": "auto",
              "target": {
                "objectKind": "software",
                "link": "connected_to"
              }
            }
          ]
        }
      ]
    },
